{
  "version": 2,
  "builds": [
    { "src": "inject-env.js", "use": "@vercel/node" },
    { "src": "api/send-email.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/send-email", "dest": "/api/send-email.js" },
    { "src": "/", "dest": "/inject-env.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
