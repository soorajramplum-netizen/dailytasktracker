{
  "version": 2,
  "builds": [
    { "src": "inject-env.js",        "use": "@vercel/node" },
    { "src": "api/send-email.js",    "use": "@vercel/node" },
    { "src": "api/cron-email.js",    "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/send-email",  "dest": "/api/send-email.js"  },
    { "src": "/api/cron-email",  "dest": "/api/cron-email.js"  },
    { "src": "/",                "dest": "/inject-env.js"       },
    { "src": "/(.*)",            "dest": "/$1"                  }
  ],
  "crons": [
    {
      "path": "/api/cron-email",
      "schedule": "0 15 * * *"
    }
  ]
}
